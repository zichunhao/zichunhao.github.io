{% comment %} Local override of al_folio_core footer.liquid: plain footer at the end of the page content, no sticky/fixed band. {% endcomment %}
<footer class="mt-5 pb-3" role="contentinfo">
  <div class="container text-center">
    <small class="text-muted">
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.footer_text }}
      {% if site.impressum_path -%}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {%- endif %}
      {% if site.last_updated %}Last updated: {{ 'now' | date: '%B %d, %Y' }}.{% endif %}
    </small>
  </div>
</footer>
